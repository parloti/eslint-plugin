{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Emit
    "declaration": true,
    "declarationMap": true,
    "inlineSourceMap": true,
    "inlineSources": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.e2e.ts",
    "**/*.test.ts",
    "src/**/__tests__/**",
    "dist",
    "coverage",
    "node_modules"
  ]
}
