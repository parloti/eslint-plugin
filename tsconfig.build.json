{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Modules

    // Emit
    "declaration": true,
    "declarationMap": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "outDir": "dist",
    "rootDir": "src",

    // Projects
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "*.d.ts"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.e2e.ts",
    "**/*.test.ts",
    "dist",
    "coverage",
    "node_modules"
  ]
}
