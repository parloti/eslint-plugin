{
  "name": "@codeperfect/eslint-plugin",
  "version": "1.0.0",
  "description": "Custom ESLint rules for TypeScript repositories",
  "license": "MIT",
  "repository": "github:parloti/eslint-plugin",
  "homepage": "https://github.com/parloti/eslint-plugin#readme",
  "bugs": "https://github.com/parloti/eslint-plugin/issues",
  "author": "CodePerfect",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./angular": {
      "types": "./dist/adapters/angular/plugin.d.ts",
      "import": "./dist/adapters/angular/plugin.js",
      "default": "./dist/adapters/angular/plugin.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "\n# ---------------- GENERAL  ---------------- #": "",
    "prepare": "patch-package && husky",
    "\n# ------------------ SCM  ------------------ #": "",
    "commit": "npx --yes git-cz",
    "\n# ---------------- BUILDING ---------------- #": "",
    "build": "task-runner run build",
    "clean": "npx --yes rimraf dist",
    "\n    • ---------- compilation  ---------- •": "",
    "pack": "npm pack --pack-destination dist",
    "compile": "tsc --build --force ./tsconfig.app.json",
    "resolve-paths": "npx --yes tsc-alias --project ./tsconfig.app.json --resolve-full-paths",
    "\n# ---------------- LINTING  ---------------- #": "",
    "\n    • ------------ checking ------------ •": "",
    "eslint": "npx --yes eslint --max-warnings=0",
    "lint": "task-runner run lint",
    "prettier": "npx --yes prettier --ignore-unknown --check .",
    "\n    • ------------- fixing ------------- •": "",
    "eslint:fix": "task-runner run eslint:fix",
    "lint:fix": "task-runner run lint:fix",
    "lint:staged": "npx --yes tsx scripts/lint-staged.ts",
    "fmt": "npm run prettier -- --write",
    "\n    • ------------ helpers  ------------ •": "",
    "check:rules": "npx --yes eslint-config-prettier eslint.config.ts",
    "eslint:inspect": "npx --yes @eslint/config-inspector",
    "\n# ---------------- TESTING  ---------------- #": "",
    "e2e": "npx --yes vitest run --no-color --config vitest.config.e2e.ts",
    "mutation": "npx --yes stryker run",
    "test:all": "task-runner run test:all",
    "typecheck": "tsc --project tsconfig.types.json",
    "validate": "task-runner run validate",
    "validate:ci": "task-runner run validate --ci",
    "\n    • -------------- unit -------------- •": "",
    "test": "npx --yes vitest run --no-color",
    "tdd": "npm run test -- --watch --silent=true --coverage.enabled=false",
    "\n# ------------------ DOCS ------------------ #": "",
    "docs": "npm run docs:clean && npm run docs:api",
    "docs:api": "npx --yes typedoc --options typedoc.json",
    "docs:clean": "npx --yes rimraf docs/api"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "custom-rules",
    "typescript",
    "linting",
    "nodejs"
  ],
  "dependencies": {
    "@typescript-eslint/utils": "^8.72.0",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@angular/compiler": "^22.2.3",
    "@codeperfect/commitlint-config-emoji": "^1.1.0",
    "@codeperfect/eslint-config": "^2.3.0",
    "@codeperfect/task-runner": "^1.1.0",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@typescript-eslint/rule-tester": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "chalk": "^6.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.3.0",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-package-json": "^1.11.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-rxjs-x": "^1.0.6",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "listr2": "^11.4.0",
    "lodash-es": "^4.18.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "tsc-alias": "^1.9.9",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@angular/compiler": ">=22.2.3",
    "eslint": ">=10.13.0"
  },
  "peerDependenciesMeta": {
    "@angular/compiler": {
      "optional": true
    }
  }
}
