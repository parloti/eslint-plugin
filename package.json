{
  "name": "@codeperfect/eslint-plugin",
  "version": "1.0.0",
  "description": "Custom ESLint rules for TypeScript repositories",
  "license": "MIT",
  "repository": "github:parloti/eslint-plugin",
  "homepage": "https://github.com/parloti/eslint-plugin#readme",
  "bugs": "https://github.com/parloti/eslint-plugin/issues",
  "author": "CodePerfect",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "\n# ---------------- GENERAL  ---------------- #": "",
    "prepare": "patch-package && husky",
    "\n# ------------------ SCM  ------------------ #": "",
    "commit": "npx --yes git-cz",
    "\n# ---------------- BUILDING ---------------- #": "",
    "build": "npx --yes tsx scripts/managed-tasks.ts build",
    "clean": "npx --yes rimraf dist",
    "\n    • ---------- compilation  ---------- •": "",
    "pack": "npm pack --pack-destination dist",
    "compile": "tsc --build --force ./tsconfig.app.json",
    "resolve-paths": "npx --yes tsc-alias --project ./tsconfig.app.json --resolve-full-paths",
    "\n# ---------------- LINTING  ---------------- #": "",
    "\n    • ------------ checking ------------ •": "",
    "eslint": "npx --yes eslint --max-warnings=0",
    "lint": "npm run lint:run",
    "lint:run": "npx --yes tsx scripts/managed-tasks.ts lint:run",
    "prettier": "npx --yes prettier --ignore-unknown --check .",
    "\n    • ------------- fixing ------------- •": "",
    "eslint:fix": "npx --yes tsx scripts/managed-tasks.ts eslint:fix",
    "lint:fix": "npx --yes tsx scripts/managed-tasks.ts lint:fix",
    "lint:staged": "npx --yes tsx scripts/lint-staged.ts",
    "fmt": "npm run prettier -- --write",
    "\n    • ------------ helpers  ------------ •": "",
    "check:rules": "npx --yes eslint-config-prettier eslint.config.ts",
    "eslint:inspect": "npx --yes @eslint/config-inspector",
    "\n# ---------------- TESTING  ---------------- #": "",
    "e2e": "npx --yes vitest run --config vitest.config.e2e.ts",
    "mutation": "npx --yes stryker run",
    "test:all": "npx --yes tsx scripts/managed-tasks.ts test:all",
    "typecheck": "tsc --project tsconfig.types.json",
    "validate": "npx --yes tsx scripts/managed-tasks.ts validate",
    "\n    • -------------- unit -------------- •": "",
    "test": "npx --yes vitest run",
    "tdd": "npm run test -- --watch --silent=true --coverage.enabled=false",
    "\n# ------------------ DOCS ------------------ #": "",
    "docs": "npm run docs:clean && npm run docs:api",
    "docs:api": "npx --yes typedoc --options typedoc.json",
    "docs:clean": "npx --yes rimraf docs/api"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "custom-rules",
    "typescript",
    "linting",
    "nodejs"
  ],
  "dependencies": {
    "@typescript-eslint/utils": "^8.70.0",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@codeperfect/commitlint-config-emoji": "^1.1.0",
    "@codeperfect/eslint-config": "^1.18.0",
    "@commitlint/cz-commitlint": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.2",
    "@typescript-eslint/rule-tester": "^8.70.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "chalk": "^6.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-rxjs-x": "^1.0.6",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "listr2": "^11.1.0",
    "lodash-es": "^4.18.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "tsc-alias": "^1.9.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "eslint": ">=10.11.0"
  }
}
