{
  "name": "@codeperfect/eslint-plugin",
  "version": "1.0.0",
  "description": "Custom ESLint rules for TypeScript repositories",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "custom-rules",
    "typescript",
    "linting"
  ],
  "homepage": "https://github.com/parloti/eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/parloti/eslint-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parloti/eslint-plugin.git"
  },
  "license": "MIT",
  "author": "CodePerfect",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "\n# ---------------- GENERAL  ---------------- #": "",
    "postinstall": "patch-package",
    "\n# ------------------ SCM  ------------------ #": "",
    "commit": "npx --yes git-cz",
    "prepare": "husky",
    "\n# ---------------- BUILDING ---------------- #": "",
    "build": "npm run clean && npm run compile && npm run resolve-paths",
    "clean": "npx --yes rimraf dist",
    "\n    • ---------- compilation  ---------- •": "",
    "pack": "npm pack --pack-destination dist",
    "compile": "tsc --build --force ./tsconfig.build.json",
    "resolve-paths": "tsc-alias --project ./tsconfig.build.json --resolve-full-paths",
    "\n# ---------------- LINTING  ---------------- #": "",
    "\n    • ------------ checking ------------ •": "",
    "eslint": "npx --yes eslint --max-warnings=0",
    "lint": "npm run lint:run",
    "lint:run": "npm run prettier && npm run eslint",
    "prettier": "npx --yes prettier --ignore-unknown --check .",
    "\n    • ------------- fixing ------------- •": "",
    "eslint:fix": "npm run check:rules && npm run eslint -- --fix",
    "lint:fix": "npm run prettier:write && npm run eslint:fix",
    "lint:staged": "npx --yes tsx scripts/lint-staged.ts",
    "prettier:write": "npm run prettier -- --write",
    "\n    • ------------ helpers  ------------ •": "",
    "check:rules": "npx --yes eslint-config-prettier eslint.config.ts",
    "eslint:inspect": "npx --yes @eslint/config-inspector",
    "\n# ---------------- TESTING  ---------------- #": "",
    "e2e": "npx --yes vitest run --config vitest.config.e2e.ts",
    "mutation": "npx --yes stryker run",
    "test:all": "npm run test --if-present && npm run e2e --if-present && npm run mutation --if-present",
    "typecheck": "tsc --noEmit",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run typecheck:spec && npm run test:all && npm run build --if-present && npm run pack --if-present",
    "\n    • -------------- unit -------------- •": "",
    "test": "npx --yes vitest run",
    "tdd": "npm run test -- --watch --silent=true --coverage.enabled=false",
    "\n# ------------------ DOCS ------------------ #": "",
    "docs": "npm run docs:clean && npm run docs:api",
    "docs:api": "npx --yes typedoc --options typedoc.json",
    "docs:clean": "npx --yes rimraf docs/api"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.60.0",
    "minimatch": "^10.2.5"
  },
  "peerDependencies": {
    "eslint": ">=10.4.1"
  },
  "devDependencies": {
    "@codeperfect/commitlint-config-emoji": "^1.0.0",
    "@codeperfect/eslint-config": "^1.11.0",
    "@commitlint/cz-commitlint": "^21.0.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@types/signale": "^1.4.7",
    "@typescript-eslint/rule-tester": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/eslint-plugin": "^1.6.19",
    "chalk": "^5.6.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-eslint-plugin": "^7.3.3",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-rxjs-x": "^1.0.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.7",
    "lodash-es": "^4.18.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.3",
    "tsc-alias": "^1.8.17",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
